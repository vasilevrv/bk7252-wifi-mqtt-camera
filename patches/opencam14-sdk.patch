@@ -0,0 +1,82 @@
+#include "cam_mqtt_config.h"
+#include <string.h>
+#include <stdio.h>
+#include <ctype.h>
+static const char hex[] = "0123456789abcdef";
+static int number(const char *p, size_t n, unsigned max, unsigned *out) {
+    size_t i; unsigned v = 0;
+    if (!n || n > 5) return -1;
+    for (i = 0; i < n; ++i) { if (p[i] < '0' || p[i] > '9') return -1; v = v*10 + p[i]-'0'; }
+    if (v > max) return -1; *out = v; return 0;
+}
+static int valid(const struct cam_mqtt_config *c) {
+    size_t i;
+    if (c->enabled > 1 || !c->port || (c->enabled && !c->host[0])) return 0;
+    for (i = 0; c->host[i]; ++i)
+        if (!isalnum((unsigned char)c->host[i]) && c->host[i] != '.' && c->host[i] != '-') return 0;
+    for (i = 0; c->client_id[i]; ++i)
+        if (!isalnum((unsigned char)c->client_id[i]) && c->client_id[i] != '_' && c->client_id[i] != '-') return 0;
+    if (strpbrk(c->topic_base, "+#\r\n") || strchr(c->username, '\r') || strchr(c->password, '\r')) return 0;
+    return !c->password[0] || c->username[0];
+}
+int cam_mqtt_parse(const char *text, size_t length, struct cam_mqtt_config *out) {
+    struct cam_mqtt_config c; const char *keys[] = {"host", "username", "password", "client_id", "topic_base"};
+    char *parts[5]; const size_t caps[] = {64,32,64,32,64}; size_t pos = 0; unsigned seen = 0;
+    memset(&c, 0, sizeof(c)); c.enabled = 1; c.port = 1883;
+    parts[0]=c.host; parts[1]=c.username; parts[2]=c.password; parts[3]=c.client_id; parts[4]=c.topic_base;
+    if (length > 512 || memchr(text, 0, length)) return -1;
+    if (length >= 3 && !memcmp(text, "\xef\xbb\xbf", 3)) pos = 3;
+    while (pos < length) {
+        size_t start = pos, end, key, n, i; const char *eq; unsigned flag, v;
+        while (pos < length && text[pos] != '\n') ++pos;
+        end = pos; if (pos < length) ++pos;
+        if (end > start && text[end-1] == '\r') --end;
+        if (end == start || text[start] == '#') continue;
+        eq = memchr(text + start, '=', end-start); if (!eq) return -1;
+        key = (size_t)(eq-text-start); n = end-(size_t)(eq-text)-1;
+        for (i = 0; i < 5; ++i) if (strlen(keys[i]) == key && !memcmp(text+start, keys[i], key)) break;
+        if (i < 5) {
+            flag = 1u << i; if (n >= caps[i] || memchr(eq+1, '\r', n)) return -1;
+            memcpy(parts[i], eq+1, n); parts[i][n] = 0;
+        } else if (key == 4 && !memcmp(text+start, "port", 4)) {
+            flag = 32; if (number(eq+1, n, 65535, &v) || !v) return -1; c.port = v;
+        } else if (key == 7 && !memcmp(text+start, "enabled", 7)) {
+            flag = 64; if (number(eq+1, n, 1, &v)) return -1; c.enabled = v;
+        } else return -1;
+        if (seen & flag) return -1; seen |= flag;
+    }
+    if (!seen || !valid(&c)) return -1; *out = c; return 0;
+}
+int cam_mqtt_encode(const struct cam_mqtt_config *c, char out[CAM_MQTT_RECORD_MAX]) {
+    const char *parts[] = {c->host,c->username,c->password,c->client_id,c->topic_base}; size_t i,j,k;
+    if (!valid(c)) return -1;
+    k = (size_t)snprintf(out, CAM_MQTT_RECORD_MAX, "01:%u:%u", c->enabled, c->port);
+    for (i = 0; i < 5; ++i) {
+        out[k++] = ':';
+        for (j = 0; parts[i][j]; ++j) {
+            unsigned char b=parts[i][j]; if (k+2 >= CAM_MQTT_RECORD_MAX) return -1;
+            out[k++]=hex[b>>4]; out[k++]=hex[b&15];
+        }
+    }
+    out[k] = 0; return 0;
+}
+static int nibble(char c) { const char *p=strchr(hex,c); return c && p ? (int)(p-hex) : -1; }
+int cam_mqtt_decode(const char *text, struct cam_mqtt_config *out) {
+    struct cam_mqtt_config c; char *parts[5]; const size_t caps[]={64,32,64,32,64};
+    size_t k=3,start,i,j; unsigned v;
+    if (!text || strlen(text) >= CAM_MQTT_RECORD_MAX || strncmp(text,"01:",3)) return -1;
+    memset(&c,0,sizeof(c)); parts[0]=c.host;parts[1]=c.username;parts[2]=c.password;parts[3]=c.client_id;parts[4]=c.topic_base;
+    start=k;while(text[k] && text[k]!=':')++k;
+    if (text[k]!=':' || number(text+start,k-start,1,&v))return -1;c.enabled=v;start=++k;
+    while(text[k] && text[k]!=':')++k;
+    if (text[k]!=':' || number(text+start,k-start,65535,&v) || !v)return -1;c.port=v;
+    for(i=0;i<5;++i) {
+        if(text[k]!=':')return -1;++k;j=0;
+        while(text[k] && text[k]!=':') {
+            int a=nibble(text[k]),b=nibble(text[k+1]);
+            if(a<0 || b<0 || j+1>=caps[i] || !(a||b))return -1;
+            parts[i][j++]=(char)((a<<4)|b);k+=2;
+        }
+    }
+    if(text[k] || !valid(&c))return -1;*out=c;return 0;
+}
