diff --git a/test/cam_auto.c b/test/cam_auto.c
new file mode 100644
index 0000000..99cf2e8
--- /dev/null
+++ b/test/cam_auto.c
@@ -0,0 +1,166 @@
+/* Autonomous camera boot: optional SD provisioning, EasyFlash, DHCP, RTSP and Telnet. */
+#include <rtthread.h>
+#include <rtdevice.h>
+#include <finsh.h>
+#include <wlan_dev.h>
+#include <dfs_fs.h>
+#include <dfs_file.h>
+#include <dfs_posix.h>
+#include <easyflash.h>
+#include <lwip/tcpip.h>
+#include <lwip/priv/tcpip_priv.h>
+#include <lwip/netif.h>
+#include <lwip/dhcp.h>
+/* RT-Thread driver accessor returns the actual netif. Beken net_get_sta_handle
+ * instead returns a wrapper structure in this SDK and must not be cast. */
+extern struct netif *wlan_get_sta_netif(void);
+#include "cam_wifi_config.h"
+#include <string.h>
+#define WIFI_FILE "/sd/wifi.conf"
+#define WIFI_KEY "cam_wifi_v1"
+#define RETRY_TICKS (20u * RT_TICK_PER_SECOND)
+extern int rtsp_cam(int argc, char **argv);
+extern int cam_rtsp_active(void);
+extern void telnet_server(void);
+extern void cam_mqtt_configure(int flash_ok);
+extern void cam_mqtt_ensure(int ready, const char *ip);
+static volatile int running, stopping, has_config, link_ready;
+static char current_ip[16];
+struct ip_snapshot { struct tcpip_api_call_data call; int ready; char ip[16]; };
+static err_t snapshot_ip(struct tcpip_api_call_data *call) {
+    struct ip_snapshot *s = (struct ip_snapshot *)call;
+    struct netif *n = wlan_get_sta_netif();
+    if (n && netif_is_up(n) && netif_is_link_up(n) &&
+        !ip4_addr_isany(netif_ip4_addr(n)) && dhcp_supplied_address(n)) {
+        s->ready = 1; ip4addr_ntoa_r(netif_ip4_addr(n), s->ip, sizeof(s->ip));
+    }
+    return ERR_OK;
+}
+/* 0 missing, 1 valid, -1 malformed/unreadable. Never execute configuration as shell commands. */
+static int read_sd(struct cam_wifi_config *cfg) {
+    struct dfs_fd fd; char text[513]; int n, used = 0;
+    static int mount_attempted;
+    struct dfs_filesystem *fs = dfs_filesystem_lookup("/sd");
+    if (!fs || strcmp(fs->path, "/sd")) {
+        /* No card-detect signal is established on this board. A failed
+         * hardware probe must not run every20s during video playback.
+         * Try once per boot; mounted-card config polling remains enabled. */
+        if (!mount_attempted) {
+            mount_attempted = 1;
+            if (rt_device_find("sd0"))
+                dfs_mount("sd0", "/sd", "elm", 0, RT_NULL);
+        }
+        fs = dfs_filesystem_lookup("/sd");
+        if (!fs || strcmp(fs->path, "/sd")) return 0;
+    }
+    memset(&fd, 0, sizeof(fd));
+    if (dfs_file_open(&fd, WIFI_FILE, O_RDONLY) < 0) return 0;
+    while (used < (int)sizeof(text)) {
+        n = dfs_file_read(&fd, text + used, sizeof(text) - used);
+        if (n <= 0) break;
+        used += n;
+    }
+    dfs_file_close(&fd);
+    if (n < 0 || cam_wifi_parse(text, used, cfg)) return -1;
+    return 1;
+}
+static int join_wifi(struct cam_wifi_config *cfg) {
+    struct rt_wlan_device *dev = (struct rt_wlan_device *)rt_device_find("w0");
+    struct rt_wlan_info info; int result;
+    if (!dev) return -1;
+    memset(&info, 0, sizeof(info));
+    if (rt_wlan_init(dev, WIFI_STATION)) return -1;
+    rt_wlan_info_init(&info, WIFI_STATION,
+        cfg->password[0] ? SECURITY_WPA2_MIXED_PSK : SECURITY_OPEN, cfg->ssid);
+    if (!info.ssid) return -1;
+    result = rt_wlan_connect(dev, &info, cfg->password);
+    rt_wlan_info_deinit(&info); return result;
+}
+static void auto_thread(void *arg) {
+    struct cam_wifi_config cfg = {{0},{0}}, sd;
+    struct cam_auto_policy policy = {0};
+    uint32_t sd_at = 0; int sd_first = 1, sd_state = 0;
+    int flash_ok = easyflash_init() == EF_NO_ERR;
+    int flash_warned = 0, mqtt_configured = 0;
+    char record[CAM_WIFI_RECORD_MAX];
+    (void)arg;
+    if (flash_ok && !cam_wifi_decode(ef_get_env(WIFI_KEY), &cfg)) {
+        has_config = 1; rt_kprintf("cam_auto: Wi-Fi loaded from internal flash\n");
+    }
+    if (!flash_ok) rt_kprintf("cam_auto: internal flash settings unavailable\n");
+    if (!rt_thread_find("telnet")) telnet_server();
+    while (!stopping) {
+        uint32_t now = (uint32_t)rt_tick_get(); unsigned actions; int changed = 0;
+        struct ip_snapshot snap;
+        if (sd_first || (uint32_t)(now - sd_at) >= RETRY_TICKS) {
+            int result; sd_first = 0; sd_at = now; result = read_sd(&sd);
+            if (result < 0 && sd_state != -1)
+                rt_kprintf("cam_auto: invalid /sd/wifi.conf; keeping previous Wi-Fi\n");
+            if (result == 1) {
+                if (!has_config || strcmp(cfg.ssid, sd.ssid) || strcmp(cfg.password, sd.password)) {
+                    cfg = sd; has_config = 1; changed = 1;
+                    rt_kprintf("cam_auto: Wi-Fi updated from SD\n");
+                }
+            }
+            if (has_config && flash_ok && !cam_wifi_encode(&cfg, record)) {
+                /* Unchanged values do not cause flash writes. Retry dirty saves
+                 * even when the SD card has subsequently been removed. */
+                int error = ef_set_env(WIFI_KEY, record);
+                if (!error) error = ef_save_env();
+                if (error) {
+                    if (!flash_warned) rt_kprintf("cam_auto: Wi-Fi flash save failed; will retry\n");
+                    flash_warned = 1;
+                } else {
+                    if (changed || flash_warned) rt_kprintf("cam_auto: Wi-Fi saved in internal flash\n");
+                    flash_warned = 0;
+                }
+            }
+            sd_state = result;
+            if (!has_config && !policy.tried) {
+                rt_kprintf("cam_auto: add ssid/password to /sd/wifi.conf for first setup\n");
+                policy.tried = 1; policy.join_at = now;
+            }
+        }
+        if (!mqtt_configured) { cam_mqtt_configure(flash_ok); mqtt_configured = 1; }
+        memset(&snap, 0, sizeof(snap));
+        if (tcpip_api_call(snapshot_ip, &snap.call) != ERR_OK) snap.ready = 0;
+        if (changed) snap.ready = 0;
+        if (snap.ready && !link_ready)
+            rt_kprintf("cam_auto: Wi-Fi ready, IP %s; RTSP :8554/stream; Telnet :23\n", snap.ip);
+        if (!snap.ready && link_ready) rt_kprintf("cam_auto: Wi-Fi lost; retry in 20 seconds\n");
+        link_ready = snap.ready; memcpy(current_ip, snap.ip, sizeof(current_ip));
+        actions = cam_auto_step(&policy, now, RETRY_TICKS, has_config, changed,
+                               snap.ready, cam_rtsp_active());
+        if (actions & CAM_AUTO_JOIN) {
+            rt_kprintf("cam_auto: connecting Wi-Fi; next retry in 20 seconds\n");
+            if (join_wifi(&cfg)) rt_kprintf("cam_auto: Wi-Fi join request failed\n");
+        }
+        if (actions & CAM_AUTO_RTSP) {
+            char *cmd[] = {"rtsp_cam", "start"}; rtsp_cam(2, cmd);
+        }
+        cam_mqtt_ensure(snap.ready, snap.ip);
+        rt_thread_delay(RT_TICK_PER_SECOND);
+    }
+    running = 0;
+}
+int cam_auto(int argc, char **argv) {
+    if (argc != 2) { rt_kprintf("cam_auto start|stop|status\n"); return -1; }
+    if (!strcmp(argv[1], "status")) {
+        rt_kprintf("cam_auto: running=%d configured=%d ready=%d IP=%s RTSP=%d\n",
+            running, has_config, link_ready, current_ip, cam_rtsp_active()); return 0;
+    }
+    if (!strcmp(argv[1], "stop")) { stopping = 1; return 0; }
+    if (!strcmp(argv[1], "start")) {
+        rt_thread_t t;
+        if (running) return 0;
+        stopping = 0; has_config = link_ready = 0; current_ip[0] = 0;
+        t = rt_thread_create("camauto", auto_thread, RT_NULL, 4096, 22, 10);
+        if (!t) return -1;
+        running = 1;
+        if (rt_thread_startup(t) != RT_EOK) { running = 0; rt_thread_delete(t); return -1; }
+        return 0;
+    }
+    return -1;
+}
+void cam_auto_boot(void) { char *cmd[] = {"cam_auto", "start"}; cam_auto(2, cmd); }
+MSH_CMD_EXPORT(cam_auto, autonomous Wi-Fi RTSP and Telnet);
diff --git a/test/cam_frame_pool.c b/test/cam_frame_pool.c
new file mode 100644
index 0000000..129d40f
--- /dev/null
+++ b/test/cam_frame_pool.c
@@ -0,0 +1,28 @@
+#include "cam_frame_pool.h"
+#include <string.h>
+void cam_pool_init(struct cam_frame_pool *p) {
+    memset(p,0,sizeof(*p)); p->writing=p->ready=p->reading=-1;
+}
+int cam_pool_reserve(struct cam_frame_pool *p) {
+    int i;
+    if(p->writing>=0)return -1;
+    for(i=0;i<CAM_FRAME_SLOTS;++i)
+        if(i!=p->ready && i!=p->reading){p->writing=i;return i;}
+    return -1;
+}
+int cam_pool_commit(struct cam_frame_pool *p,uint32_t length,uint32_t tick) {
+    int signal;
+    if(p->writing<0)return 0;
+    if(!length){p->writing=-1;return 0;}
+    signal=p->ready<0;
+    if(!signal)++p->replaced;
+    p->length[p->writing]=length;p->tick[p->writing]=tick;
+    p->ready=p->writing;p->writing=-1;++p->captured;
+    return signal;
+}
+int cam_pool_take(struct cam_frame_pool *p) {
+    int i;
+    if(p->reading>=0 || p->ready<0)return -1;
+    i=p->ready;p->reading=i;p->ready=-1;return i;
+}
+void cam_pool_release(struct cam_frame_pool *p,int i){if(p->reading==i)p->reading=-1;}
