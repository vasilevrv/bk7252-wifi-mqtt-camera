+
+/* Reference Rockchip HI704 driver labels P20:88..8A=02BF20 as
+ * 50Hz ExpMax8fps. Half that exposure budget is our reversible fast profile;
+ * it does not force fixed frame timing or change clock/blanking. */
+#define HI704_STOCK_EXPOSURE 0x02bf20u
+#define HI704_FAST_EXPOSURE  0x015f90u
+static UINT32 hi704_exposure=HI704_FAST_EXPOSURE;
+static int hi704_initialized,hi704_profile_verified;
+static int hi704_set_exposure(UINT32 value) {
+    UINT8 page=0x20,ae=0x1c,readback[3]={0};unsigned i;int failed=0;
+    hi704_profile_verified=0;
+    failed|=camera_intf_sccb_write2(HI704_DEV_ID,0x03,&page,1);
+    failed|=camera_intf_sccb_write2(HI704_DEV_ID,0x10,&ae,1);
+    for(i=0;i<3;++i) {
+        UINT8 byte=(UINT8)(value>>(16-8*i));
+        failed|=camera_intf_sccb_write2(HI704_DEV_ID,0x88+i,&byte,1);
+        failed|=camera_intf_sccb_read2(HI704_DEV_ID,0x88+i,&readback[i],1);
+        if(readback[i]!=byte)failed=1;
+    }
+    ae=0x9c;failed|=camera_intf_sccb_write2(HI704_DEV_ID,0x10,&ae,1);
+    page=0;failed|=camera_intf_sccb_write2(HI704_DEV_ID,0x03,&page,1);
+    if(!failed){hi704_exposure=value;hi704_profile_verified=1;}
+    os_printf("HI704 exposure max=%02x%02x%02x verify=%s\r\n",readback[0],readback[1],readback[2],failed?"FAILED":"OK");
+    return failed?-1:0;
+}
+static int hi704_fps(int argc,char **argv) {
+    UINT32 value;
+    if(argc!=2){rt_kprintf("hi704_fps fast|stock|status\n");return -1;}
+    if(!strcmp(argv[1],"status")){rt_kprintf("HI704 initialized=%d verified=%d exposure_limit=%u profile=%s\n",hi704_initialized,hi704_profile_verified,(unsigned)hi704_exposure,hi704_exposure==HI704_FAST_EXPOSURE?"fast":"stock");return 0;}
+    if(!strcmp(argv[1],"fast"))value=HI704_FAST_EXPOSURE;
+    else if(!strcmp(argv[1],"stock"))value=HI704_STOCK_EXPOSURE;
+    else return -1;
+    if(!hi704_initialized){hi704_exposure=value;return 0;}
+    { UINT32 previous=hi704_exposure;
+      if(!hi704_set_exposure(value))return 0;
+      hi704_set_exposure(previous);return -1;
+    }
+}
+MSH_CMD_EXPORT(hi704_fps, HI704 exposure profile with stock rollback);
 
