diff --git a/test/cam_rtsp.c b/test/cam_rtsp.c
new file mode 100644
index 0000000..6d4821c
--- /dev/null
+++ b/test/cam_rtsp.c
@@ -0,0 +1,516 @@
+/* One video consumer, RTSP/1.0 and RFC 2435 RTP/JPEG over interleaved TCP. */
+#ifdef CAM_RTSP_HOST
+#include "cam_rtsp_host.h"
+#else
+#include "include.h"
+#include <rtthread.h>
+#include <finsh.h>
+#include <dfs_posix.h>
+#include <sys/socket.h>
+#include "net.h"
+#include "video_transfer.h"
+#endif
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <ctype.h>
+#include <errno.h>
+#include "cam_rtp_jpeg.h"
+#include "cam_frame_pool.h"
+#include "cam_snapshot.h"
+#include "cam_stream_info.h"
+
+#define CAM_PORT 8554
+#define CAM_FRAME_MAX (48u * 1024u) /* Three slots fit the measured SDRAM heap. */
+#define CAM_CAPTURE_TIMEOUT_MS 500 /* Allow slow exposure; bound shutdown. */
+#define CAM_INPUT_MAX 2048
+#define CAM_PACKET_MAX 1400 /* One complete interleaved record fits TCP MSS. */
+#define CAM_SEND_BATCH (2 * CAM_PACKET_MAX)
+static volatile int cam_running, cam_stop;
+static unsigned cam_clients, cam_frames, cam_bad_frames;
+static unsigned cam_captured, cam_replaced, cam_timeouts;
+static unsigned cam_tcp_frames,cam_stale;
+static unsigned cam_send_calls,cam_send_ms_max,cam_send_slow,cam_frame_ms_max,cam_age_ms_max;
+struct cam_capture {
+    struct cam_frame_pool pool;
+    uint8_t *frames;
+    rt_mutex_t lock;
+    rt_sem_t ready, done;
+    volatile int stop;
+};
+static void cam_capture_thread(void *arg) {
+    struct cam_capture *c=arg;
+    while(!c->stop) {
+        int slot, signal; uint32_t length, tick;
+        rt_mutex_take(c->lock,RT_WAITING_FOREVER);
+        slot=cam_pool_reserve(&c->pool);
+        rt_mutex_release(c->lock);
+        if(slot<0){rt_thread_delay(1);continue;}
+        length=video_buffer_read_frame_timeout(c->frames+(size_t)slot*CAM_FRAME_MAX,CAM_FRAME_MAX,CAM_CAPTURE_TIMEOUT_MS);
+        tick=(uint32_t)rt_tick_get();
+        if(length)cam_snapshot_offer(c->frames+(size_t)slot*CAM_FRAME_MAX,length,tick);
+        rt_mutex_take(c->lock,RT_WAITING_FOREVER);
+        signal=cam_pool_commit(&c->pool,length,tick);
+        cam_captured=c->pool.captured;cam_replaced=c->pool.replaced;
+        if(!length)++cam_timeouts;
+        if(signal)rt_sem_release(c->ready);
+        rt_mutex_release(c->lock);
+    }
+    rt_sem_release(c->done);
+}
+static int cam_capture_take(struct cam_capture *c, uint8_t **frame, uint32_t *length, uint32_t *tick) {
+    int slot;
+    if(rt_sem_take(c->ready,rt_tick_from_millisecond(200))!=RT_EOK)return -1;
+    rt_mutex_take(c->lock,RT_WAITING_FOREVER);
+    slot=cam_pool_take(&c->pool);
+    if(slot>=0){*frame=c->frames+(size_t)slot*CAM_FRAME_MAX;*length=c->pool.length[slot];*tick=c->pool.tick[slot];}
+    rt_mutex_release(c->lock);return slot;
+}
+static void cam_capture_release(struct cam_capture *c,int slot) {
+    rt_mutex_take(c->lock,RT_WAITING_FOREVER);cam_pool_release(&c->pool,slot);rt_mutex_release(c->lock);
+}
+
+int cam_rtsp_active(void) { return cam_running; }
+void cam_stream_get_info(struct cam_stream_info *info) {
+    VIDEO_TRANSFER_STATS_ST source;video_transfer_get_stats(&source);
+    info->source_frames=source.frames;info->captured=cam_captured;
+    info->replaced=cam_replaced;info->bad=cam_bad_frames;
+}
+
+struct cam_session {
+    int fd, setup, playing, teardown, report_pending;
+    unsigned channel, rtcp_channel;
+    uint16_t sequence;
+    uint32_t ssrc, timestamp, origin, activity, report, packets, octets;
+    char id[16];
+    char input[CAM_INPUT_MAX + 1];
+    size_t used;
+    unsigned discard;
+    uint8_t packet[CAM_SEND_BATCH];
+};
+
+static uint32_t cam_ticks(void) { return (uint32_t)rt_tick_get(); }
+static uint32_t cam_ms(uint32_t ticks) {
+    return (uint32_t)((uint64_t)ticks * 1000 / RT_TICK_PER_SECOND);
+}
+static void cam_put32(uint8_t *p, uint32_t v) {
+    p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v;
+}
+static int cam_send(struct cam_session *s, const void *data, size_t length)
+{
+    const char *p = data;
+    uint32_t start = cam_ticks();
+    while (length && !cam_stop) {
+        uint32_t at=cam_ticks();
+        int n = send(s->fd, p, length, 0);
+        unsigned elapsed=cam_ms(cam_ticks()-at);
+        ++cam_send_calls;if(elapsed>cam_send_ms_max)cam_send_ms_max=elapsed;
+        if(elapsed>100)++cam_send_slow;
+        if (n <= 0) return -1;
+        p += n; length -= n;
+        if (cam_ms(cam_ticks() - start) >= 2000 && length) return -1;
+    }
+    return length ? -1 : 0;
+}
+static int cam_response(struct cam_session *s, unsigned cseq, unsigned code,
+                        const char *reason, const char *headers, const char *body)
+{
+    char response[1536];
+    size_t length = body ? strlen(body) : 0;
+    int n = snprintf(response, sizeof(response),
+        "RTSP/1.0 %u %s\r\nCSeq: %u\r\nServer: HB6\r\n%sContent-Length: %u\r\n\r\n%s",
+        code, reason, cseq, headers ? headers : "", (unsigned)length, body ? body : "");
+    if (n < 0 || (size_t)n >= sizeof(response)) return -1;
+    return cam_send(s, response, n);
+}
+static int cam_equal(const char *a, const char *b, size_t n)
+{
+    size_t i;
+    for (i = 0; i < n; ++i)
+        if (tolower((unsigned char)a[i]) != tolower((unsigned char)b[i])) return 0;
+    return 1;
+}
+/* Find one header only. Reject duplicates instead of interpreting conflicting
+ * Content-Length/CSeq/Session values differently in different layers. */
+static int cam_header(const char *request, const char *name, char *value, size_t cap)
+{
+    const char *p = strstr(request, "\r\n");
+    size_t key = strlen(name);
+    int found = 0;
+    if (!p) return -1;
+    p += 2;
+    while (*p && strncmp(p, "\r\n", 2)) {
+        const char *end = strstr(p, "\r\n"), *colon;
+        if (!end) return -1;
+        colon = memchr(p, ':', end - p);
+        if (!colon) return -1;
+        if ((size_t)(colon - p) == key && cam_equal(p, name, key)) {
+            const char *v = colon + 1, *tail = end;
+            if (found++) return -1;
+            while (v < tail && (*v == ' ' || *v == '\t')) ++v;
+            while (tail > v && (tail[-1] == ' ' || tail[-1] == '\t')) --tail;
+            if ((size_t)(tail - v) >= cap) return -1;
+            memcpy(value, v, tail - v); value[tail - v] = 0;
+        }
+        p = end + 2;
+    }
+    return found;
+}
+static int cam_number(const char *text, unsigned *n)
+{
+    unsigned value = 0;
+    if (!*text) return -1;
+    while (*text) {
+        unsigned digit = (unsigned char)*text++ - '0';
+        if (digit > 9 || value > (0x7fffffffu - digit) / 10) return -1;
+        value = value * 10 + digit;
+    }
+    *n = value;
+    return 0;
+}
+/* Exactly one unicast transport; never accept an arbitrary destination IP. */
+static int cam_transport(const char *text, unsigned *rtp, unsigned *rtcp)
+{
+    char copy[256], *p, *token;
+    int seen=0,unicast=0;
+    if(strlen(text)>=sizeof(copy))return -1;
+    strcpy(copy,text);token=strchr(copy,';');if(!token)return -1;*token++=0;
+    /* UDP exhausts the vendor Wi-Fi TX allocator on this board. */
+    if(strcmp(copy,"RTP/AVP/TCP"))return -1;
+    p=token;
+    while(p) {
+        char *end=strchr(p,';');if(end)*end++=0;
+        if(!strcmp(p,"unicast")){if(unicast++)return -1;}
+        else if(!strncmp(p,"interleaved=",12)) {
+            char *dash=strchr(p+12,'-');if(seen++ || !dash)return -1;*dash++=0;
+            if(cam_number(p+12,rtp) || cam_number(dash,rtcp))return -1;
+            if(*rtp>255 || *rtcp>255 || *rtp==*rtcp)return -1;
+        } else if(strcmp(p,"mode=play") && strcmp(p,"mode=\"PLAY\""))return -1;
+        p=end;
+    }
+    return seen==1 && unicast==1?0:-1;
+}
+static int cam_request(struct cam_session *s, const char *request)
+{
+    char method[24], uri[384], version[16], value[256], headers[512];
+    unsigned cseq = 0;
+    const char *path;
+    int session;
+    if (cam_header(request, "CSeq", value, sizeof(value)) != 1 || cam_number(value, &cseq)) {
+        cam_response(s, 0, 400, "Bad Request", 0, 0);
+        return -1;
+    }
+    if (sscanf(request, "%23s %383s %15s", method, uri, version) != 3 || strcmp(version, "RTSP/1.0"))
+        return cam_response(s, cseq, 400, "Bad Request", 0, 0);
+    path = uri;
+    if (!strncmp(uri, "rtsp://", 7)) {
+        path = strchr(uri + 7, '/');
+        if (!path) path = "/";
+    }
+    if (strcmp(method, "OPTIONS") && strcmp(path, "/stream") &&
+        strcmp(path, "/stream/") && strcmp(path, "/stream/track0"))
+        return cam_response(s, cseq, 404, "Not Found", 0, 0);
+    session = cam_header(request, "Session", value, sizeof(value));
+    if (session < 0) return cam_response(s, cseq, 400, "Bad Request", 0, 0);
+    if (session) {
+        char *semi = strchr(value, ';');
+        if (semi) *semi = 0;
+        if (!s->setup || strcmp(value, s->id))
+            return cam_response(s, cseq, 454, "Session Not Found", 0, 0);
+    }
+    s->activity = cam_ticks();
+    if (!strcmp(method, "OPTIONS"))
+        return cam_response(s, cseq, 200, "OK",
+            "Public: OPTIONS, DESCRIBE, SETUP, PLAY, PAUSE, GET_PARAMETER, TEARDOWN\r\n", 0);
+    if (!strcmp(method, "DESCRIBE")) {
+        static const char sdp[] = "v=0\r\no=- 1 1 IN IP4 0.0.0.0\r\ns=HB6 camera\r\n"
+            "c=IN IP4 0.0.0.0\r\nt=0 0\r\na=control:*\r\n"
+            "m=video 0 RTP/AVP 26\r\na=rtpmap:26 JPEG/90000\r\na=control:track0\r\n";
+        if (strcmp(path, "/stream") && strcmp(path, "/stream/"))
+            return cam_response(s, cseq, 404, "Not Found", 0, 0);
+        snprintf(headers, sizeof(headers), "Content-Type: application/sdp\r\nContent-Base: %s%s\r\n",
+                 uri, uri[strlen(uri) - 1] == '/' ? "" : "/");
+        return cam_response(s, cseq, 200, "OK", headers, sdp);
+    }
+    if (!strcmp(method, "SETUP")) {
+        unsigned channel = 0, rtcp = 1;
+        if (strcmp(path, "/stream/track0")) return cam_response(s, cseq, 404, "Not Found", 0, 0);
+        if (s->setup) return cam_response(s, cseq, 455, "Method Not Valid in This State", 0, 0);
+        if (cam_header(request, "Transport", value, sizeof(value)) != 1 || cam_transport(value, &channel, &rtcp))
+            return cam_response(s, cseq, 461, "Unsupported Transport", 0, 0);
+        s->channel = channel; s->rtcp_channel = rtcp; s->setup = 1;
+        snprintf(headers, sizeof(headers), "Session: %s;timeout=60\r\n"
+                 "Transport: RTP/AVP/TCP;unicast;interleaved=%u-%u;ssrc=%08X\r\n",
+                 s->id, channel, rtcp, (unsigned)s->ssrc);
+        return cam_response(s, cseq, 200, "OK", headers, 0);
+    }
+    if (!strcmp(method, "PLAY") || !strcmp(method, "PAUSE") ||
+        !strcmp(method, "GET_PARAMETER") || !strcmp(method, "TEARDOWN")) {
+        if (!session || !s->setup) return cam_response(s, cseq, 454, "Session Not Found", 0, 0);
+        snprintf(headers, sizeof(headers), "Session: %s\r\n", s->id);
+        if (!strcmp(method, "PLAY")) {
+            if (s->playing) return cam_response(s, cseq, 455, "Method Not Valid in This State", 0, 0);
+            s->playing = 1;
+            s->report_pending = 1;
+            s->report = cam_ticks();
+        } else if (!strcmp(method, "PAUSE")) {
+            if (!s->playing) return cam_response(s, cseq, 455, "Method Not Valid in This State", 0, 0);
+            s->playing = 0;
+        } else if (!strcmp(method, "TEARDOWN")) {
+            s->playing = 0; s->teardown = 1;
+        }
+        return cam_response(s, cseq, 200, "OK", headers, 0);
+    }
+    return cam_response(s, cseq, 405, "Method Not Allowed", 0, 0);
+}
+
+/* TCP requests and RTCP can be split/coalesced arbitrarily. Keep incomplete
+ * requests, consume their bounded bodies, and drain interleaved packets. */
+static int cam_input(struct cam_session *s)
+{
+    for (;;) {
+        size_t total, header;
+        char value[32], *end;
+        unsigned body = 0;
+        if (s->discard) {
+            size_t n = s->used < s->discard ? s->used : s->discard;
+            memmove(s->input, s->input + n, s->used - n);
+            s->used -= n; s->discard -= n;
+            if (s->discard) return 0;
+        }
+        if (!s->used) return 0;
+        if (s->input[0] == '$') {
+            if (s->used < 4) return 0;
+            if (!s->setup || (uint8_t)s->input[1] != s->rtcp_channel) return -1;
+            s->discard = ((uint8_t)s->input[2] << 8) | (uint8_t)s->input[3];
+            memmove(s->input, s->input + 4, s->used - 4); s->used -= 4;
+            s->activity = cam_ticks();
+            continue;
+        }
+        s->input[s->used] = 0;
+        end = strstr(s->input, "\r\n\r\n");
+        if (!end) return s->used == CAM_INPUT_MAX || memchr(s->input, 0, s->used) ? -1 : 0;
+        header = end + 4 - s->input;
+        if (memchr(s->input, 0, header)) return -1;
+        /* Temporarily isolate headers; following pipelined bytes are binary. */
+        { char saved = s->input[header];
+          int found;
+          s->input[header] = 0;
+          found = cam_header(s->input, "Content-Length", value, sizeof(value));
+          s->input[header] = saved;
+          if (found < 0 || (found && cam_number(value, &body))) return -1;
+        }
+        total = header + body;
+        if (total > CAM_INPUT_MAX) return -1;
+        if (total > s->used) return 0;
+        { char saved = s->input[header]; int result;
+          s->input[header] = 0;
+          result = cam_request(s, s->input);
+          s->input[header] = saved;
+          if (result) return -1;
+        }
+        memmove(s->input, s->input + total, s->used - total); s->used -= total;
+        if (s->teardown) return 0;
+    }
+}
+
+static int cam_report(struct cam_session *s, uint32_t tick)
+{
+    uint8_t p[64] = {0};
+    char cname[24];
+    size_t name, sdes, length;
+    uint32_t sec = tick / RT_TICK_PER_SECOND;
+    uint32_t frac = ((uint64_t)(tick % RT_TICK_PER_SECOND) << 32) / RT_TICK_PER_SECOND;
+    snprintf(cname, sizeof(cname), "%08x@hb6", (unsigned)s->ssrc);
+    name = strlen(cname); sdes = (4 + 4 + 2 + name + 1 + 3) & ~3u;
+    length = 28 + sdes;
+    p[0] = '$'; p[1] = s->rtcp_channel; p[2] = length >> 8; p[3] = length;
+    p[4] = 0x80; p[5] = 200; p[7] = 6;
+    /* No wall clock is configured on the board. RFC 3550 permits relative
+     * NTP timestamps from uptime; high bit zero distinguishes them from
+     * contemporary absolute NTP time. Send the first SR before any RTP. */
+    cam_put32(p + 8, s->ssrc); cam_put32(p + 12, sec);
+    cam_put32(p + 16, frac);
+    cam_put32(p + 20, (uint32_t)((uint64_t)(tick - s->origin) * 90000 / RT_TICK_PER_SECOND));
+    cam_put32(p + 24, s->packets); cam_put32(p + 28, s->octets);
+    p[32] = 0x81; p[33] = 202; p[35] = sdes / 4 - 1;
+    cam_put32(p + 36, s->ssrc); p[40] = 1; p[41] = name;
+    memcpy(p + 42, cname, name);
+    return cam_send(s, p, length + 4);
+}
+static void cam_client(int fd, struct cam_capture *capture)
+{
+    struct cam_session *s = calloc(1, sizeof(*s));
+    struct timeval timeout = {2, 0};
+    unsigned bad = 0;
+    int frame_slot = -1;
+    uint8_t *frame = NULL;
+    uint32_t last_frame = cam_ticks();
+    if (!s) return;
+    s->fd = fd; s->origin = s->activity = cam_ticks();
+    s->ssrc = 0x48423600u ^ s->origin ^ ++cam_clients;
+    s->sequence = s->ssrc;
+    snprintf(s->id, sizeof(s->id), "%08x", (unsigned)s->ssrc);
+    if (setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))) goto done;
+    { int on = 1; setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on)); }
+    rt_kprintf("RTSP client connected; session %s\n", s->id);
+    while (!cam_stop && !s->teardown && cam_ms(cam_ticks() - s->activity) < 60000) {
+        fd_set readset;
+        int ready;
+        timeout.tv_sec = 0; timeout.tv_usec = s->playing ? 0 : 200000;
+        FD_ZERO(&readset); FD_SET(fd, &readset);
+        ready = select(fd + 1, &readset, 0, 0, &timeout);
+        if (ready < 0) break;
+        if (ready && FD_ISSET(fd,&readset)) {
+            int n = recv(fd, s->input + s->used, CAM_INPUT_MAX - s->used, 0);
+            if (n <= 0) break;
+            s->used += n;
+            if (cam_input(s) || s->teardown) break;
+        }
+        if (s->playing) {
+            struct cam_jpeg j;
+            size_t offset = 0; uint32_t length = 0, captured_tick = 0;
+            uint32_t tick,send_start;unsigned age,frame_ms;
+            int result;
+            tick = cam_ticks();
+            if (s->report_pending || cam_ms(tick - s->report) >= 5000) {
+                if (cam_report(s, tick)) break;
+                s->report = tick; s->report_pending = 0;
+            }
+            frame_slot = cam_capture_take(capture, &frame, &length, &captured_tick);
+            tick = cam_ticks();
+            if (frame_slot < 0) {
+                if (cam_ms(tick - last_frame) >= 5000) {
+                    rt_kprintf("RTSP: no camera frames for 5s; disconnecting\n"); break;
+                }
+                continue;
+            }
+            last_frame = tick;
+            age=cam_ms(tick-captured_tick);if(age>cam_age_ms_max)cam_age_ms_max=age;
+            if(age>150){++cam_stale;cam_capture_release(capture,frame_slot);frame_slot=-1;continue;}
+            result = cam_jpeg_parse(frame, length, &j);
+            if (result) {
+                ++cam_bad_frames;
+                if (!bad++) rt_kprintf("RTSP: unsupported/malformed JPEG, error=%d length=%u\n", result, (unsigned)length);
+                cam_capture_release(capture,frame_slot);frame_slot=-1;
+                if (bad >= 10) break;
+                continue;
+            }
+            bad = 0;
+            if ((uint32_t)(tick-captured_tick) > (uint32_t)(tick-s->origin)) captured_tick=s->origin;
+            s->timestamp = (uint32_t)((uint64_t)(captured_tick - s->origin) * 90000 / RT_TICK_PER_SECOND);
+            send_start=cam_ticks();
+            while (offset < j.length && !cam_stop) {
+                size_t batch = 0;
+                unsigned count;
+                /* Coalesce two records per socket write. Do not wait for a
+                 * second camera frame: the last record is flushed immediately. */
+                for (count = 0; count < 2 && offset < j.length; ++count) {
+                    size_t consumed, n = cam_rtp_packet(&j, offset, s->channel, s->sequence++,
+                        s->timestamp, s->ssrc, s->packet + batch, CAM_PACKET_MAX, &consumed);
+                    if (!n) goto done;
+                    offset += consumed;
+                    batch+=n;
+                    ++s->packets; s->octets += n - 16;
+                }
+                if (cam_send(s, s->packet, batch)) goto done;
+            }
+            if (cam_stop) break;
+            frame_ms=cam_ms(cam_ticks()-send_start);if(frame_ms>cam_frame_ms_max)cam_frame_ms_max=frame_ms;
+            ++cam_frames; ++cam_tcp_frames;
+            cam_capture_release(capture,frame_slot);frame_slot=-1;
+        } else last_frame = cam_ticks();
+    }
+done:
+    if(frame_slot>=0)cam_capture_release(capture,frame_slot);
+    rt_kprintf("RTSP client disconnected\n");
+    free(s);
+}
+static void cam_server(void *arg)
+{
+    struct sockaddr_in addr;
+    struct cam_capture capture;
+    rt_thread_t producer=RT_NULL;
+    int producer_started=0;
+    memset(&capture,0,sizeof(capture));cam_pool_init(&capture.pool);
+    capture.frames=malloc((size_t)CAM_FRAME_SLOTS*CAM_FRAME_MAX);
+    capture.lock=rt_mutex_create("camlock",RT_IPC_FLAG_FIFO);
+    capture.ready=rt_sem_create("camready",0,RT_IPC_FLAG_FIFO);
+    capture.done=rt_sem_create("camdone",0,RT_IPC_FLAG_FIFO);
+    int listener = -1, on = 1;
+    (void)arg;
+    if (!capture.frames || !capture.lock || !capture.ready || !capture.done) goto done;
+    listener = socket(AF_INET, SOCK_STREAM, 0);
+    if (listener < 0) goto done;
+    setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+    memset(&addr, 0, sizeof(addr)); addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY); addr.sin_port = htons(CAM_PORT);
+    if (bind(listener, (struct sockaddr *)&addr, sizeof(addr)) || listen(listener, 1)) goto done;
+    if(video_buffer_open()!=0)goto done;
+    cam_captured=cam_replaced=cam_timeouts=0;
+    producer=rt_thread_create("camcap",cam_capture_thread,&capture,2048,19,10);
+    if(!producer)goto done;
+    if(rt_thread_startup(producer)!=RT_EOK){rt_thread_delete(producer);producer=RT_NULL;goto done;}
+    producer_started=1;
+    rt_kprintf("RTSP listening: rtsp://<camera-ip>:8554/stream (TCP)\n");
+    while (!cam_stop) {
+        fd_set readset;
+        struct timeval timeout = {0, 200000};
+        int ready, client;
+        FD_ZERO(&readset); FD_SET(listener, &readset);
+        ready = select(listener + 1, &readset, 0, 0, &timeout);
+        if (ready < 0) break;
+        if (!ready) continue;
+        client = accept(listener, 0, 0);
+        if (client < 0) continue;
+        cam_client(client, &capture);
+        close(client);
+    }
+done:
+    if (listener >= 0) close(listener);
+    capture.stop=1;
+    if(producer_started)rt_sem_take(capture.done,RT_WAITING_FOREVER);
+    if(capture.ready)rt_sem_delete(capture.ready);
+    if(capture.done)rt_sem_delete(capture.done);
+    if(capture.lock)rt_mutex_delete(capture.lock);
+    free(capture.frames);
+    cam_running = 0;
+    rt_kprintf("RTSP server stopped (camera remains initialized)\n");
+}
+int rtsp_cam(int argc, char **argv)
+{
+    if (argc != 2) { rt_kprintf("rtsp_cam start|stop|status\n"); return -1; }
+    if (!strcmp(argv[1], "status")) {
+        VIDEO_BUFFER_STATS_ST stats;
+        VIDEO_TRANSFER_STATS_ST source;
+        video_buffer_get_stats(&stats);
+        video_transfer_get_stats(&source);
+        rt_kprintf("RTSP running=%d clients=%u frames=%u bad=%u captured=%u replaced=%u timeouts=%u\n", cam_running, cam_clients, cam_frames, cam_bad_frames,cam_captured,cam_replaced,cam_timeouts);
+        rt_kprintf("VBUF started=%u valid=%u overflows=%u invalid=%u gaps=%u timeouts=%u max_bytes=%u\n",
+                   (unsigned)stats.started,(unsigned)stats.valid,(unsigned)stats.overflows,
+                   (unsigned)stats.invalid,(unsigned)stats.gaps,(unsigned)stats.timeouts,
+                   (unsigned)stats.max_frame_len);
+        rt_kprintf("VIDEO source_frames=%u node_drops=%u queue_drops=%u\n",
+                   (unsigned)source.frames,(unsigned)source.node_drops,(unsigned)source.queue_drops);
+        rt_kprintf("TRANSPORT mode=TCP tcp_frames=%u stale=%u send_calls=%u slow_sends=%u send_max_ms=%u frame_max_ms=%u age_max_ms=%u\n",cam_tcp_frames,cam_stale,cam_send_calls,cam_send_slow,cam_send_ms_max,cam_frame_ms_max,cam_age_ms_max);
+        return 0;
+    }
+    if (!strcmp(argv[1], "stop")) { cam_stop = 1; return 0; }
+    if (strcmp(argv[1], "start")) return -1;
+    if (cam_running) { rt_kprintf("RTSP already running\n"); return -1; }
+    /* The shared SDK frame buffer supports exactly one reader. */
+    if (rt_thread_find("jpeg_stream")) {
+        rt_kprintf("HTTP camera task active; reboot and start RTSP first\n"); return -1;
+    }
+    { rt_thread_t thread;
+      cam_stop = 0; cam_running = 1;
+      thread = rt_thread_create("rtspcam", cam_server, 0, 6144, 20, 10);
+      if (!thread) { cam_running = 0; return -1; }
+      if (rt_thread_startup(thread)) { rt_thread_delete(thread); cam_running = 0; return -1; }
+    }
+    return 0;
+}
+#ifndef CAM_RTSP_HOST
+MSH_CMD_EXPORT(rtsp_cam, RTSP JPEG camera on TCP port 8554);
+#endif
diff --git a/test/cam_snapshot.c b/test/cam_snapshot.c
new file mode 100644
index 0000000..b0b8ea4
--- /dev/null
+++ b/test/cam_snapshot.c
@@ -0,0 +1,55 @@
+/* One bounded snapshot mailbox. Capture never waits for MQTT/network IO.
+ * Scheduler locks protect metadata only; copying/publishing occurs outside. */
+#include <rtthread.h>
+#include <string.h>
+#include "cam_snapshot.h"
+enum { EMPTY, REQUESTED, WRITING, READY, READING };
+static unsigned state, enabled;
+static uint8_t *pieces[CAM_SNAPSHOT_CHUNKS];
+static size_t image_length;
+static uint32_t captured_tick;
+int cam_snapshot_enable(void) {
+    unsigned i;
+    if(enabled)return 0;
+    for(i=0;i<CAM_SNAPSHOT_CHUNKS;++i) {
+        pieces[i]=rt_malloc(CAM_SNAPSHOT_CHUNK);
+        if(!pieces[i]) {
+            while(i)rt_free(pieces[--i]);
+            memset(pieces,0,sizeof(pieces));return -1;
+        }
+    }
+    rt_enter_critical();enabled=1;state=EMPTY;rt_exit_critical();return 0;
+}
+void cam_snapshot_request(void) {
+    rt_enter_critical();if(enabled && state==EMPTY)state=REQUESTED;rt_exit_critical();
+}
+void cam_snapshot_offer(const uint8_t *frame,size_t length,uint32_t tick) {
+    size_t offset;
+    rt_enter_critical();
+    if(!enabled || state!=REQUESTED){rt_exit_critical();return;}
+    state=WRITING;rt_exit_critical();
+    /* SDK appends five transport bytes after EOI; publish a full JPEG only. */
+    if(length<9 || length-5>CAM_SNAPSHOT_MAX || frame[0]!=0xff || frame[1]!=0xd8 ||
+       frame[length-7]!=0xff || frame[length-6]!=0xd9) {
+        rt_enter_critical();state=REQUESTED;rt_exit_critical();return;
+    }
+    length-=5;
+    for(offset=0;offset<length;) {
+        size_t n=length-offset;if(n>CAM_SNAPSHOT_CHUNK)n=CAM_SNAPSHOT_CHUNK;
+        memcpy(pieces[offset/CAM_SNAPSHOT_CHUNK],frame+offset,n);offset+=n;
+    }
+    rt_enter_critical();image_length=length;captured_tick=tick;state=READY;rt_exit_critical();
+}
+size_t cam_snapshot_take(uint32_t *tick) {
+    size_t length=0;
+    rt_enter_critical();if(state==READY){state=READING;length=image_length;*tick=captured_tick;}rt_exit_critical();return length;
+}
+const uint8_t *cam_snapshot_piece(size_t offset,size_t *length) {
+    size_t n;
+    if(state!=READING || offset>=image_length)return NULL;
+    n=image_length-offset;if(n>CAM_SNAPSHOT_CHUNK-offset%CAM_SNAPSHOT_CHUNK)n=CAM_SNAPSHOT_CHUNK-offset%CAM_SNAPSHOT_CHUNK;
+    *length=n;return pieces[offset/CAM_SNAPSHOT_CHUNK]+offset%CAM_SNAPSHOT_CHUNK;
+}
+void cam_snapshot_release(void) {
+    rt_enter_critical();if(state==READING)state=EMPTY;rt_exit_critical();
+}
diff --git a/test/cam_snapshot.h b/test/cam_snapshot.h
new file mode 100644
index 0000000..6f80115
--- /dev/null
+++ b/test/cam_snapshot.h
@@ -0,0 +1,14 @@
+#ifndef CAM_SNAPSHOT_H
+#define CAM_SNAPSHOT_H
+#include <stddef.h>
+#include <stdint.h>
+#define CAM_SNAPSHOT_CHUNK (12u*1024u)
+#define CAM_SNAPSHOT_CHUNKS 4
+#define CAM_SNAPSHOT_MAX (CAM_SNAPSHOT_CHUNK*CAM_SNAPSHOT_CHUNKS)
+int cam_snapshot_enable(void);
+void cam_snapshot_request(void);
+void cam_snapshot_offer(const uint8_t *,size_t,uint32_t);
+size_t cam_snapshot_take(uint32_t *);
+const uint8_t *cam_snapshot_piece(size_t,size_t *);
+void cam_snapshot_release(void);
+#endif
