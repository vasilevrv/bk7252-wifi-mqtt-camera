+volatile struct cam_net_counters cam_net_counters;
+struct tcp_snapshot {
+    struct tcpip_api_call_data call;
+    unsigned found,sndbuf,queued,cwnd,window,pending,rto_ms,retries;
+};
+static err_t inspect_tcp(struct tcpip_api_call_data *call) {
+    struct tcp_snapshot *snap=(struct tcp_snapshot*)call;struct tcp_pcb *pcb;
+    for(pcb=tcp_active_pcbs;pcb;pcb=pcb->next)if(pcb->local_port==8554 && pcb->state==ESTABLISHED) {
+        snap->found=1;snap->sndbuf=pcb->snd_buf;snap->queued=pcb->snd_queuelen;
+        snap->cwnd=pcb->cwnd;snap->window=pcb->snd_wnd;
+        snap->pending=pcb->snd_lbb-pcb->lastack;snap->rto_ms=pcb->rto*TCP_SLOW_INTERVAL;snap->retries=pcb->nrtx;break;
+    }
+    return ERR_OK;
+}
+static int cam_net(int argc,char **argv) {
+    struct cam_net_counters stats;LinkStatusTypeDef link={0};int status;struct tcp_snapshot tcp={0};
+    GLOBAL_INT_DECLARATION();(void)argc;(void)argv;
+    GLOBAL_INT_DISABLE();stats=cam_net_counters;GLOBAL_INT_RESTORE();
+    status=bk_wlan_get_link_status(&link);
+    if(tcpip_api_call(inspect_tcp,&tcp.call)!=ERR_OK)tcp.found=0;
+    rt_kprintf("NET link_status=%d rssi=%d channel=%u mcu_ps=%d rf_ps=%d\n",status,link.wifi_strength,(unsigned)link.channel,bk_wlan_mcu_ps_get_enable_flag(),bk_wlan_dtim_rf_ps_get_enable_flag());
+    rt_kprintf("NET enqueued=%u queue_fail=%u queue_slow=%u queue_wait_max_ms=%u coalesce_fail=%u node_fail=%u descriptor_fail=%u rtsp_rto=%u rtsp_fast_rexmit=%u\n",stats.enqueued,stats.queue_fail,stats.queue_slow,stats.queue_wait_max_ms,stats.coalesce_fail,stats.node_fail,stats.descriptor_fail,stats.rtsp_rto,stats.rtsp_fast_rexmit);
+    rt_kprintf("NET jpeg_period_ms=%u max_ms=%u over150ms=%u\n",stats.jpeg_period_last_ms,stats.jpeg_period_max_ms,stats.jpeg_long_periods);
+    rt_kprintf("TCP active=%u sndbuf=%u queued_segments=%u cwnd=%u peer_window=%u pending=%u rto_ms=%u retries=%u\n",tcp.found,tcp.sndbuf,tcp.queued,tcp.cwnd,tcp.window,tcp.pending,tcp.rto_ms,tcp.retries);
+    return 0;
+}
+MSH_CMD_EXPORT(cam_net, camera network counters and real RSSI);
diff --git a/test/cam_rtp_jpeg.c b/test/cam_rtp_jpeg.c
new file mode 100644
index 0000000..841cd66
--- /dev/null
+++ b/test/cam_rtp_jpeg.c
@@ -0,0 +1,145 @@
+#include "cam_rtp_jpeg.h"
+#include <string.h>
+#include "cam_jpeg_tables.h"
+
+static unsigned be16(const uint8_t *p) { return (p[0] << 8) | p[1]; }
+static void put16(uint8_t *p, unsigned n) { p[0] = n >> 8; p[1] = n; }
+static void put32(uint8_t *p, uint32_t n) {
+    p[0] = n >> 24; p[1] = n >> 16; p[2] = n >> 8; p[3] = n;
+}
+static int default_dht(const uint8_t *p, size_t n)
+{
+    const uint8_t *table;
+    size_t size;
+    switch (*p) {
+    case 0: table = cam_dht_dc_y; size = sizeof(cam_dht_dc_y); break;
+    case 16: table = cam_dht_ac_y; size = sizeof(cam_dht_ac_y); break;
+    case 1: table = cam_dht_dc_c; size = sizeof(cam_dht_dc_c); break;
+    case 17: table = cam_dht_ac_c; size = sizeof(cam_dht_ac_c); break;
+    default: return 0;
+    }
+    return size == n && !memcmp(p, table, size);
+}
+
+/* Accept only the baseline, single-scan subset representable by RFC 2435.
+ * Do not silently turn unsupported JPEG headers into corrupt RTP frames. */
+int cam_jpeg_parse(const uint8_t *data, size_t length, struct cam_jpeg *out)
+{
+    size_t pos = 2;
+    const uint8_t *quant[4] = {0, 0, 0, 0};
+    unsigned components[3] = {0}, qids[3] = {0};
+    int sof = 0, dht = 0;
+    if (!data || !out || length < 4 || data[0] != 255 || data[1] != 0xd8) return -1;
+    memset(out, 0, sizeof(*out));
+    while (pos < length) {
+        unsigned marker, size;
+        const uint8_t *p;
+        size_t n, k;
+        if (data[pos++] != 255) return -1;
+        while (pos < length && data[pos] == 255) ++pos;
+        if (pos >= length) return -1;
+        marker = data[pos++];
+        if (pos + 2 > length) return -1;
+        size = be16(data + pos);
+        if (size < 2 || size > length - pos) return -1;
+        p = data + pos + 2; n = size - 2; pos += size;
+        switch (marker) {
+        case 0xdb:
+            for (k = 0; k < n; k += 65) {
+                if (n - k < 65 || p[k] > 3) return -2;
+                quant[p[k]] = p + k + 1;
+            }
+            break;
+        case 0xc4:
+            k = 0;
+            while (k < n) {
+                size_t symbols = 0, t;
+                if (n - k < 17) return -1;
+                for (t = 1; t <= 16; ++t) symbols += p[k + t];
+                if (symbols > n - k - 17) return -1;
+                if (!default_dht(p + k, symbols + 17)) return -3;
+                dht |= 1 << ((p[k] & 1) * 2 + (p[k] >> 4));
+                k += symbols + 17;
+            }
+            break;
+        case 0xc0:
+            if (sof || n != 15 || p[0] != 8 || p[5] != 3) return -2;
+            out->height = be16(p + 1); out->width = be16(p + 3);
+            if (!out->width || !out->height || out->width > 2040 || out->height > 2040 ||
+                (out->width & 7) || (out->height & 7)) return -2;
+            if ((p[7] != 0x21 && p[7] != 0x22) || p[10] != 0x11 || p[13] != 0x11) return -2;
+            out->type = p[7] == 0x22 ? 1 : 0;
+            for (k = 0; k < 3; ++k) {
+                components[k] = p[6 + k * 3]; qids[k] = p[8 + k * 3];
+                if (qids[k] > 3) return -2;
+            }
+            if (components[0] == components[1] || components[0] == components[2] ||
+                components[1] == components[2] || qids[1] != qids[2]) return -2;
+            sof = 1;
+            break;
+        case 0xdd:
+            if (n != 2) return -1;
+            out->restart = be16(p);
+            break;
+        case 0xda:
+            if (!sof || n != 10 || p[0] != 3 || p[7] != 0 || p[8] != 63 || p[9] != 0) return -2;
+            for (k = 0; k < 3; ++k)
+                if (p[1 + k * 2] != components[k] || p[2 + k * 2] != (k ? 0x11 : 0)) return -2;
+            if (!quant[qids[0]] || !quant[qids[1]] || dht != 15) return -2;
+            memcpy(out->quant, quant[qids[0]], 64);
+            memcpy(out->quant + 64, quant[qids[1]], 64);
+            for (k = 0; k < 128; ++k) if (!out->quant[k]) return -2;
+            out->scan = data + pos;
+            while (pos + 1 < length) {
+                size_t marker_start = pos;
+                if (data[pos++] != 255) continue;
+                /* BK7252 word-aligns EOI with FF fill bytes. JPEG permits
+                 * repeated FF prefixes before markers, including EOI/RST.
+                 * Retain the extra fill in scan data for exact reconstruction. */
+                while (pos < length && data[pos] == 255) ++pos;
+                if (pos >= length) return -1;
+                marker = data[pos++];
+                if (marker == 0) {
+                    if (pos - marker_start != 2) return -2;
+                    continue;
+                }
+                if (marker >= 0xd0 && marker <= 0xd7 && out->restart) continue;
+                if (marker != 0xd9) return -2;
+                out->length = (data + pos - 2) - out->scan;
+                if (!out->length || out->length > 0xffffff) return -1;
+                if (out->restart) out->type += 64;
+                return 0; /* Ignore vendor trailer following EOI. */
+            }
+            return -1;
+        default:
+            /* Metadata is harmless; other coding modes are not. */
+            if (!((marker >= 0xe0 && marker <= 0xef) || marker == 0xfe)) return -2;
+        }
+    }
+    return -1;
+}
+
+size_t cam_rtp_packet(const struct cam_jpeg *j, size_t offset, uint8_t channel,
+                     uint16_t sequence, uint32_t timestamp, uint32_t ssrc,
+                     uint8_t *packet, size_t capacity, size_t *consumed)
+{
+    size_t header = 24 + (j->restart ? 4 : 0) + (offset == 0 ? 132 : 0);
+    size_t n, pos = 24;
+    *consumed = 0;
+    if (offset >= j->length || capacity <= header || capacity > 65539) return 0;
+    n = j->length - offset;
+    if (n > capacity - header) n = capacity - header;
+    packet[0] = '$'; packet[1] = channel; put16(packet + 2, header + n - 4);
+    packet[4] = 0x80; packet[5] = 26 | (offset + n == j->length ? 0x80 : 0);
+    put16(packet + 6, sequence); put32(packet + 8, timestamp); put32(packet + 12, ssrc);
+    packet[16] = 0; packet[17] = offset >> 16; packet[18] = offset >> 8; packet[19] = offset;
+    packet[20] = j->type; packet[21] = 255; packet[22] = j->width / 8; packet[23] = j->height / 8;
+    if (j->restart) { put16(packet + pos, j->restart); put16(packet + pos + 2, 0xffff); pos += 4; }
+    if (!offset) {
+        packet[pos] = packet[pos + 1] = 0; put16(packet + pos + 2, 128);
+        memcpy(packet + pos + 4, j->quant, 128); pos += 132;
+    }
+    memcpy(packet + pos, j->scan + offset, n);
+    *consumed = n;
+    return pos + n;
+}
