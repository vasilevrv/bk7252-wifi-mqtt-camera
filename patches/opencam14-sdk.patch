@@ -0,0 +1,185 @@
+/* Optional MQTT autostart, using the SDK's existing Paho worker/reconnect loop. */
+#ifdef CAM_MQTT_HOST
+#include "cam_mqtt_host.h"
+#else
+#include <rtthread.h>
+#include <rtdevice.h>
+#include <netif/ethernetif.h>
+#include <finsh.h>
+#include <dfs_file.h>
+#include <dfs_posix.h>
+#include <easyflash.h>
+#include "mqtt_client.h"
+#endif
+#include "cam_mqtt_config.h"
+#include "cam_snapshot.h"
+#include "cam_stream_info.h"
+#include <string.h>
+#include <stdio.h>
+#define MQTT_KEY "cam_mqtt_v1"
+static struct cam_mqtt_config config;
+static mqtt_client client;
+static int configured, started, attempted, initialized, save_pending, flash_available;
+static uint32_t save_at;
+static uint32_t attempt_at;
+static char uri[84], availability[84], state_topic[84], image_topic[84], camera_ip[16], device_id[32];
+static char discovery_json[2048], escaped[3][512];
+static unsigned snapshots_sent,snapshot_errors;
+static volatile int snapshot_publish_enabled=1;
+static int snapshot_enabled,snapshot_pending,discovery_pending;
+static uint32_t snapshot_at,stats_at,source_at,allocation_at;
+static int allocation_attempted;
+static unsigned source_fps_x100;
+static int json_escape(const char *in,char *out,size_t cap) {
+    static const char hex[]="0123456789abcdef";size_t used=0;
+    while(*in) {
+        unsigned char c=(unsigned char)*in++;size_t n=c<32?6:(c=='"'||c=='\\'?2:1);
+        if(used+n>=cap)return -1;
+        if(c<32){out[used++]='\\';out[used++]='u';out[used++]='0';out[used++]='0';out[used++]=hex[c>>4];out[used++]=hex[c&15];}
+        else {if(n==2)out[used++]='\\';out[used++]=c;}
+    }
+    out[used]=0;return 0;
+}
+static int discovery(mqtt_client *c) {
+    char topic[128];const char *components[]={"camera","sensor","sensor","sensor"};
+    const char *names[]={"Snapshot","IP address","RTSP URL","Source FPS"};
+    const char *keys[]={"snapshot","ip","rtsp","source_fps"};unsigned i;
+    if(json_escape(availability,escaped[0],sizeof(escaped[0])) ||
+       json_escape(state_topic,escaped[1],sizeof(escaped[1])) ||
+       json_escape(image_topic,escaped[2],sizeof(escaped[2])))return -1;
+    for(i=0;i<4;++i) {
+        int n;char entity[1024];
+        if(i==0)snprintf(entity,sizeof(entity),"\"topic\":\"%s\",\"encoding\":\"\",\"json_attributes_topic\":\"%s\"",escaped[2],escaped[1]);
+        else snprintf(entity,sizeof(entity),"\"state_topic\":\"%s\",\"value_template\":\"{{ value_json.%s }}\",\"entity_category\":\"diagnostic\"%s",escaped[1],keys[i],i==3?",\"unit_of_measurement\":\"fps\"":"");
+        /* entity is bounded separately; pathological escaping must fail cleanly. */
+        if(strlen(entity)>=sizeof(entity)-1)return -1;
+        snprintf(topic,sizeof(topic),"homeassistant/%s/%s/%s/config",components[i],device_id,keys[i]);
+        n=snprintf(discovery_json,sizeof(discovery_json),"{\"name\":\"%s\",\"unique_id\":\"%s_%s\",\"availability_topic\":\"%s\",%s,\"device\":{\"identifiers\":[\"%s\"],\"name\":\"BK7252 Camera\",\"manufacturer\":\"Beken\",\"model\":\"BK7252 HI704\",\"sw_version\":\"OpenCam14\"}}",names[i],device_id,keys[i],escaped[0],entity,device_id);
+        if(n<0 || (size_t)n>=sizeof(discovery_json) || paho_mqtt_publish_retained(c,QOS0,topic,discovery_json,n)!=PAHO_SUCCESS)return -1;
+    }
+    return 0;
+}
+static int publish_state(mqtt_client *c) {
+    char ip[16],payload[512];struct cam_stream_info info;int n;
+    rt_enter_critical();memcpy(ip,camera_ip,sizeof(ip));rt_exit_critical();cam_stream_get_info(&info);
+    n=snprintf(payload,sizeof(payload),"{\"ip\":\"%s\",\"rtsp\":\"rtsp://%s:8554/stream\",\"telnet_port\":23,\"firmware\":\"OpenCam14\",\"sensor\":\"HI704\",\"width\":640,\"height\":480,\"snapshot_interval_s\":10,\"uptime_s\":%u,\"source_fps\":%u.%02u,\"source_frames\":%u,\"captured\":%u,\"replaced\":%u,\"bad\":%u,\"snapshots_sent\":%u}",ip,ip,(unsigned)(rt_tick_get()/RT_TICK_PER_SECOND),source_fps_x100/100,source_fps_x100%100,(unsigned)info.source_frames,(unsigned)info.captured,(unsigned)info.replaced,(unsigned)info.bad,snapshots_sent);
+    return n<0 || (size_t)n>=sizeof(payload)?-1:paho_mqtt_publish_retained(c,QOS0,state_topic,payload,n);
+}
+static const unsigned char *snapshot_piece(void *arg,size_t offset,size_t *length) {
+    (void)arg;return cam_snapshot_piece(offset,length);
+}
+static int loop(mqtt_client *c) {
+    uint32_t now=(uint32_t)rt_tick_get(),tick;size_t length;
+    if(!paho_mqtt_is_connected(c))return -1;
+    if(discovery_pending){if(discovery(c))return -1;discovery_pending=0;}
+    if((uint32_t)(now-stats_at)>=10u*RT_TICK_PER_SECOND) {
+        struct cam_stream_info info;cam_stream_get_info(&info);
+        source_fps_x100=(unsigned)((uint64_t)(info.source_frames-source_at)*100*RT_TICK_PER_SECOND/(uint32_t)(now-stats_at));
+        source_at=info.source_frames;stats_at=now;if(publish_state(c))return -1;
+    }
+    if(!snapshot_enabled && (!allocation_attempted || (uint32_t)(now-allocation_at)>=20u*RT_TICK_PER_SECOND)) {
+        allocation_attempted=1;allocation_at=now;
+        if(!cam_snapshot_enable()){snapshot_enabled=1;rt_kprintf("cam_mqtt: snapshot mailbox48KiB enabled\n");}
+        else rt_kprintf("cam_mqtt: snapshot allocation failed; retry in20s\n");
+    }
+    if(!snapshot_enabled || !snapshot_publish_enabled)return 0;
+    if(!snapshot_pending && (uint32_t)(now-snapshot_at)>=9u*RT_TICK_PER_SECOND){cam_snapshot_request();snapshot_pending=1;}
+    if(!snapshot_pending || (uint32_t)(now-snapshot_at)<10u*RT_TICK_PER_SECOND || !(length=cam_snapshot_take(&tick)))return 0;
+    if((uint32_t)(now-tick)>5u*RT_TICK_PER_SECOND){cam_snapshot_release();cam_snapshot_request();return 0;}
+    {
+        int rc=paho_mqtt_publish_stream(c,image_topic,length,snapshot_piece,NULL,2000);
+        cam_snapshot_release();snapshot_pending=0;snapshot_at=(uint32_t)rt_tick_get();
+        if(rc!=PAHO_SUCCESS){++snapshot_errors;return -1;}
+        ++snapshots_sent;
+    }
+    return 0;
+}
+static int read_config(struct cam_mqtt_config *out) {
+    struct dfs_fd fd; char text[513]; int n = 0, used = 0;
+    memset(&fd, 0, sizeof(fd));
+    if (dfs_file_open(&fd, "/sd/mqtt.conf", O_RDONLY) < 0) return 0;
+    while (used < (int)sizeof(text)) {
+        n = dfs_file_read(&fd, text+used, sizeof(text)-used); if (n <= 0) break; used += n;
+    }
+    dfs_file_close(&fd);
+    return n < 0 || cam_mqtt_parse(text, used, out) ? -1 : 1;
+}
+static void save_config(void) {
+    char record[CAM_MQTT_RECORD_MAX]; int error;
+    if (!flash_available || !save_pending || cam_mqtt_encode(&config,record))return;
+    save_at=(uint32_t)rt_tick_get();
+    error=ef_set_env(MQTT_KEY,record);if(!error)error=ef_save_env();
+    if(error)rt_kprintf("cam_mqtt: flash save failed; will retry\n");
+    else {save_pending=0;rt_kprintf("cam_mqtt: settings saved in internal flash\n");}
+}
+void cam_mqtt_configure(int flash_ok) {
+    struct cam_mqtt_config sd; int r;
+    if(initialized)return;initialized=1;flash_available=flash_ok;
+    if (flash_ok && !cam_mqtt_decode(ef_get_env(MQTT_KEY), &config)) configured = 1;
+    r = read_config(&sd);
+    if (r < 0) rt_kprintf("cam_mqtt: invalid /sd/mqtt.conf; keeping saved configuration\n");
+    if (r == 1) {
+        config = sd; configured = 1;
+        save_pending=1;save_config();
+    }
+    if (!configured) rt_kprintf("cam_mqtt: add /sd/mqtt.conf to configure broker\n");
+    else if (!config.enabled) rt_kprintf("cam_mqtt: disabled by configuration\n");
+}
+static void online(mqtt_client *c) {
+    struct cam_stream_info info;uint32_t tick;size_t length;
+    rt_kprintf("cam_mqtt: connected to %s:%u\n",config.host,config.port);
+    if(paho_mqtt_publish_retained(c,QOS0,availability,"online",6)!=PAHO_SUCCESS)return;
+    cam_stream_get_info(&info);stats_at=(uint32_t)rt_tick_get();source_at=info.source_frames;
+    discovery_pending=1;snapshot_pending=0;snapshot_at=stats_at-10u*RT_TICK_PER_SECOND;
+    length=cam_snapshot_take(&tick);if(length)cam_snapshot_release();
+    publish_state(c);
+}
+static void offline(mqtt_client *c) { (void)c;rt_kprintf("cam_mqtt: disconnected; retry in 20 seconds\n"); }
+void cam_mqtt_ensure(int ready, const char *ip) {
+    MQTTPacket_connectData initial = MQTTPacket_connectData_initializer;
+    uint32_t now=(uint32_t)rt_tick_get();
+    if (save_pending && (uint32_t)(now-save_at)>=20u*RT_TICK_PER_SECOND)save_config();
+    if (!ready || !configured || !config.enabled) return;
+    rt_enter_critical(); snprintf(camera_ip,sizeof(camera_ip),"%s",ip);rt_exit_critical();
+    if (started || (attempted && (uint32_t)(now-attempt_at)<20u*RT_TICK_PER_SECOND))return;
+    attempted=1;attempt_at=now;
+    if (!device_id[0]) {
+        unsigned char mac[6]={0};rt_device_t dev=rt_device_find("w0");
+        if (!dev || rt_device_control(dev,NIOCTL_GADDR,mac)!=RT_EOK) return;
+        snprintf(device_id,sizeof(device_id),"bk7252-%02x%02x%02x%02x%02x%02x",mac[0],mac[1],mac[2],mac[3],mac[4],mac[5]);
+    }
+    if(!config.client_id[0])snprintf(config.client_id,sizeof(config.client_id),"%s",device_id);
+    if (!config.topic_base[0]) snprintf(config.topic_base,sizeof(config.topic_base),"%s",config.client_id);
+    snprintf(uri,sizeof(uri),"tcp://%s:%u",config.host,config.port);
+    snprintf(availability,sizeof(availability),"%s/availability",config.topic_base);
+    snprintf(state_topic,sizeof(state_topic),"%s/state",config.topic_base);
+    snprintf(image_topic,sizeof(image_topic),"%s/snapshot",config.topic_base);
+    memset(&client,0,sizeof(client));client.sock=-1;client.uri=uri;client.condata=initial;
+    client.condata.clientID.cstring=config.client_id;
+    if(config.username[0])client.condata.username.cstring=config.username;
+    if(config.password[0])client.condata.password.cstring=config.password;
+    client.condata.cleansession=1;client.condata.keepAliveInterval=30;
+    client.condata.willFlag=1;client.condata.will.qos=0;client.condata.will.retained=1;
+    client.condata.will.topicName.cstring=availability;client.condata.will.message.cstring="offline";
+    client.online_callback=online;client.offline_callback=offline;client.loop_callback=loop;
+    client.reconnect_interval=20;client.keepalive_interval=30;client.keepalive_count=3;
+    client.connect_timeout=5;client.msg_timeout=5;
+    client.buf_size=2048;client.readbuf_size=1024;
+    client.buf=rt_calloc(1,client.buf_size);client.readbuf=rt_calloc(1,client.readbuf_size);
+    if (!client.buf || !client.readbuf || paho_mqtt_start(&client,4096,24)!=PAHO_SUCCESS) {
+        if(client.buf)rt_free(client.buf);if(client.readbuf)rt_free(client.readbuf);
+        client.buf=client.readbuf=RT_NULL;rt_kprintf("cam_mqtt: start failed; retry in 20 seconds\n");return;
+    }
+    started=1;rt_kprintf("cam_mqtt: worker started, base topic %s\n",config.topic_base);
+}
+int cam_mqtt(int argc,char **argv) {
+    if(argc==3 && !strcmp(argv[1],"snapshots")) {
+        if(!strcmp(argv[2],"on"))snapshot_publish_enabled=1;
+        else if(!strcmp(argv[2],"off"))snapshot_publish_enabled=0;
+        else return -1;
+    } else if(argc!=1){rt_kprintf("cam_mqtt [snapshots on|off]\n");return -1;}
+    rt_kprintf("cam_mqtt: configured=%d enabled=%d started=%d connected=%d broker=%s:%u base=%s\n",
+        configured,config.enabled,started,started?paho_mqtt_is_connected(&client):0,config.host,config.port,config.topic_base);
+    rt_kprintf("cam_mqtt: snapshots=%u errors=%u mailbox=%d publish_enabled=%d source_fps=%u.%02u\n",snapshots_sent,snapshot_errors,snapshot_enabled,snapshot_publish_enabled,source_fps_x100/100,source_fps_x100%100);return 0;
+}
+MSH_CMD_EXPORT(cam_mqtt, show camera MQTT status);
